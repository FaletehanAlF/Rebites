# Salin ke .env lalu isi nilainya. JANGAN commit nilai asli ke git.
# PENTING: setelah mengubah .env, restart dev server agar terbaca ulang.
#
# Catatan TLS lokal (Windows): bila Node/Next.js gagal mencapai Supabase
# dengan error sertifikat (UNABLE_TO_VERIFY_LEAF_SIGNATURE / fetch failed)
# padahal browser/curl berhasil, jalankan dev server dengan:
#   NODE_USE_SYSTEM_CA=1
# Ini keterbatasan environment lokal, BUKAN bug aplikasi. Jangan pernah
# memakai NODE_TLS_REJECT_UNAUTHORIZED=0 (melemahkan keamanan).

# Supabase (wajib). URL + anon key dipakai browser & server;
# service role HANYA server (lib/server/supabase.ts). Jangan beri
# prefix NEXT_PUBLIC_ pada service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL untuk redirect/invoice (wajib di production, mis. https://rebites.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Xendit (server-only, JANGAN pakai prefix NEXT_PUBLIC_).
XENDIT_SECRET_KEY=
# Token callback webhook: isi SALAH SATU (dipakai x-callback-token).
XENDIT_CALLBACK_TOKEN=
XENDIT_WEBHOOK_TOKEN=

# 7C-1: Biteship Sandbox (server-only, JANGAN pakai prefix NEXT_PUBLIC_).
# API key dibuat dari dashboard Biteship (Testing Mode untuk sandbox).
# Jangan commit nilai asli ke git.
BITESHIP_API_KEY=
# Daftar courier Biteship dipisah koma untuk rate request (server-side).
# Contoh pengisian (tanpa spasi): jne,sicepat,anteraja
BITESHIP_COURIERS=
# 7C-3C-4: shared secret untuk webhook Biteship (server-only).
# Konfigurasikan dashboard Biteship mengirim nilai ini via header
# x-webhook-secret (atau Authorization: Bearer). Mekanisme signature/HMAC
# tidak terdokumentasi Biteship; JANGAN mengarang. Jangan commit nilai asli.
BITESHIP_WEBHOOK_SECRET=

