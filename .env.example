
# Copy to .env.local for local development.
# Never commit real credentials or secrets.

# --- Supabase ---
# Required: Project URL and public anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin ---
SUPER_ADMIN_USER_ID=

# --- Xendit ---
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_WEBHOOK_TOKEN=
BITESHIP_WEBHOOK_SECRET=

# --- Delivery / Biteship ---
BITESHIP_API_KEY=
BITESHIP_COURIERS=
DELIVERY_BASE_FEE_IDR=5000
DELIVERY_PER_KM_FEE_IDR=2500
DELIVERY_MIN_FEE_IDR=5000
DELIVERY_MAX_FEE_IDR=50000
VIBE_CODE_URL=
VIBE_CODE_KEY=
# Opsional. Default di kode: deepseek-v4.1-flash
#
# Gateway VibeCode menyediakan 9 model. Semuanya sudah diuji dapat dipanggil
# dan semuanya mendukung function calling (syarat agar asisten admin bisa
# membaca data lewat tools). Pilih satu, lalu isi di sini:
#
#   deepseek-v4.1-flash   default; jawaban singkat, cepat
#   deepseek-v4-pro       penalaran lebih dalam, lebih lambat
#   gpt-6.1-sol           cepat (~1,7 dtk)
#   gpt-6.1-terra         paling cepat saat diuji (~1,5 dtk)
#   gpt-6-luna
#   glm-5.3-flashx
#   mimo-v2.6-flash       kadang membalas kosong pada prompt sangat pendek
#   mimo-v2.6-pro
#   minimax-m3.1-flash    paling lambat saat diuji (~9 dtk)
#
# Ganti model tidak mengubah keamanan: prompt, penjaga, dan tools tetap sama.
VIBE_CODE_MODEL=
# Opsional. Kunci HMAC untuk token konfirmasi aksi admin.
# Bila kosong, diturunkan dari SUPABASE_SERVICE_ROLE_KEY (tidak pernah memakai
# service key mentah sebagai kunci).
CHATBOT_ACTION_SECRET=
