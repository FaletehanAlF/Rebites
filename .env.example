# Copy to `.env.local` for local development (never commit real values).
# Required keys are marked REQUIRED.

# --- Supabase ---------------------------------------------------------------
# REQUIRED. Project URL (Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
# REQUIRED. Anon/public key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# REQUIRED (server only). Service role key — bypasses RLS.
# NEVER prefix with NEXT_PUBLIC_ and never import it in client components.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -------------------------------------------------------------------
# Base URL used for auth redirects and Xendit success/failure redirects.
# e.g. http://localhost:3000 or https://rebites.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Xendit (payments) ------------------------------------------------------
# REQUIRED for checkout & subscriptions (server only).
XENDIT_SECRET_KEY=
# Shared secret sent as `x-callback-token` by Xendit webhooks.
# Server only; either name is accepted by app/api/webhooks/xendit.
XENDIT_CALLBACK_TOKEN=
# Alternative/legacy name for the same webhook token.
XENDIT_WEBHOOK_TOKEN=
