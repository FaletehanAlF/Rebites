
# Copy to .env.local for local development.
# Never commit real credentials or secrets.

# --- Supabase ---
# Required: Project URL and public anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin ---
SUPER_ADMIN_USER_ID=

# --- Xendit ---
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_WEBHOOK_TOKEN=
BITESHIP_WEBHOOK_SECRET=

# --- Delivery / Biteship ---
BITESHIP_API_KEY=
BITESHIP_COURIERS=
DELIVERY_BASE_FEE_IDR=5000
DELIVERY_PER_KM_FEE_IDR=2500
DELIVERY_MIN_FEE_IDR=5000
DELIVERY_MAX_FEE_IDR=50000
