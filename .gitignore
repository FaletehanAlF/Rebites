# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# `.env*.local` mencakup .env.development.local, .env.production.local,
# .env.test.local, dsb — semuanya dibaca Next.js. Tanpa pola ini, menyalin
# .env.local untuk kebutuhan lokal lalu `git add .` akan meng-commit
# service-role key dan kunci pembayaran ke repositori.
.env
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local verification & debug artifacts (Tahap 4B: jangan commit log/skrip verifikasi lokal)
*.log
p1b-verify.mjs
remote_schema_verify.sql
